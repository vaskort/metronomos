# Netlify / Cloudflare Pages header rules.
# GitHub Pages ignores this file — it cannot serve custom headers, so the
# header-only protections below do not apply there.

/*
  # frame-ancestors is ignored in a <meta> tag, so it has to be set here.
  # The rest of the policy is injected into index.html at build time.
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

# Hashed filenames are immutable; the service worker and index.html are not.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
