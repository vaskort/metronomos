{
  "files.associations": {
    ".eslintrc": "jsonc",
    ".prettierrc": "jsonc"
  },

  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "html",
    "typescriptreact"
  ],

  "javascript.validate.enable": false,
  "javascript.format.enable": false,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "typescript.format.enable": false,

  "search.exclude": {
    ".git": true,
    ".eslintcache": true,
    "dist-web": true,
    "dev-dist": true,
    "node_modules": true,
    "package-lock.json": true
  }
}
